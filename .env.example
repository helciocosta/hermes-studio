# Configuração de produção consolidada
PORT=6060
PREVIEW_FRONTEND_PORT=8651
XAI_OAUTH_PORT=56121
HERMES_DATA_DIR=./hermes_data
WEBUI_CONTAINER_NAME=hermes-webui

# Segurança (gere valores fortes se for expor na internet)
# AUTH_TOKEN=seu-token-seguro-aqui
# AUTH_JWT_SECRET=seu-jwt-secret-aqui

PROFILE=default
LOG_LEVEL=info

# Feature flags (0=ligado, 1=desligado)
HERMES_WEB_UI_DISABLE_GATEWAY_AUTOSTART=0
HERMES_WEB_UI_DISABLE_MCP_AUTOINJECT=0
HERMES_WEB_UI_DISABLE_SKILL_INJECTION=0

# LLM Providers
# OpenRouter — acesso a 200+ modelos via uma API (inclui dezenas de modelos free)
# OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# OpenCode Zen — modelos curados via OpenCode (inclui free: big-pickle, deepseek-v4-flash-free, etc.)
# OPENCODE_ZEN_API_KEY=sk-YOUR_KEY_HERE
